# ─────────────────────────────────────────────────────────────
# DeepSI LLM API Gateway — environment template
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Application
APP_ENV=development
HOST=127.0.0.1
PORT=8085
LOG_LEVEL=info

# 9Router upstream (the gateway never connects directly to NVIDIA or StepFun)
# Must be a base URL. If no path is supplied, /v1 is appended automatically.
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
# Optional when 9Router is bound to loopback. Required for remote deployments
# where 9Router enforces API-key authentication.
NINE_ROUTER_API_KEY=

# Gateway client authentication.
# Required when APP_ENV=production (minimum 16 characters).
# Leave empty in development only for local, unauthenticated testing.
# Generate with: openssl rand -base64 48
LLM_GATEWAY_API_KEY=

# Request handling
REQUEST_TIMEOUT_SECONDS=120
MAX_REQUEST_BODY_BYTES=20971520
RATE_LIMIT_PER_MINUTE=60

# Readiness:
# false = report degraded (HTTP 200) when a configured upstream model is absent
# true  = report unready (HTTP 503) when any configured upstream model is absent
READINESS_REQUIRE_MODELS=false

# Only enable when the gateway is behind a trusted reverse proxy that sets
# X-Forwarded-For. Never trust forwarding headers on a directly exposed server.
TRUST_PROXY_HEADERS=false

# Exact browser origins, comma-separated. Wildcards are not accepted.
# Example: https://service.deepsi.space,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Public DeepSI model -> exact upstream model ID registered in 9Router.
# Verify the exact names with: curl http://127.0.0.1:20128/v1/models
DEEPSI_M1_UPSTREAM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
DEEPSI_S1_UPSTREAM_MODEL=stepfun-ai/step-5-preview
DEEPSI_V1_UPSTREAM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
DEEPSI_E1_UPSTREAM_MODEL=nvidia/nemotron-3.5-embed-8b

# NVIDIA embedding defaults (only applied when the request omits the field)
DEEPSI_E1_DEFAULT_INPUT_TYPE=query
# Leave empty unless the configured embedding model requires a modality value.
DEEPSI_E1_DEFAULT_MODALITY=
